var OWBIND = {"x":[0.01155,0.0231,0.03466,0.04621,0.06931,0.09242,0.13863,0.18484,0.23105,0.32347],"xmin":0.0,"xmax":0.333,"xlabel":"Wasserstein radius \u03b5  (treated arm)","ylabel":"\u0393* : box stops binding (W takes over)","ymin":0.0,"ymax":21.6,"series":[{"id":"frontier","label":"\u0393*(\u03b5) binding frontier","color":"#7c3aed","marker":"circle","width":3.0,"y":[3.626,4.633,5.642,6.65,8.666,10.402,12.418,14.434,16.45,19.957]}],"hlines":[{"y":1.0,"color":"#cbd5e1","dash":"2,3","label":"\u0393=1 (box collapses to nominal)"}],"note":"Binding frontier (treated arm). BELOW the line (smaller \u0393): the odds-box is tighter, so the BOX binds and the W-ball is slack. ABOVE the line (larger \u0393): the box is looser than what the W-ball already implies, so the WASSERSTEIN ball binds. The relation is near-linear, \u0393* \u2248 4.3 + 52\u00b7\u03b5; at the tight \u03b5 (c=1, green line) the box stops binding around \u0393*\u22487."};
var OWEPS_IPW = {"x":[0.301,0.699,0.9031,1.301,1.699,2.301,3.0],"xmin":0.301,"xmax":3.0,"xlabel":"log\u2081\u2080 \u0393   (\u0393: 2, 5, 8, 20, 50, 200, 1000)","ylabel":"realised E[Y]  (IPW-O-W)","ymin":-0.03,"ymax":0.316,"series":[{"id":"ceps0.5","label":"\u03b5 scale c=0.5","color":"#22c55e","marker":"circle","y":[0.2381,0.25,0.2499,0.2497,0.2499,0.2513,0.2513]},{"id":"ceps1.0","label":"\u03b5 scale c=1.0","color":"#1f77b4","marker":"circle","y":[0.1848,0.2397,0.244,0.2509,0.2373,0.1585,0.1585]},{"id":"ceps2.0","label":"\u03b5 scale c=2.0","color":"#f59e0b","marker":"circle","y":[0.1717,0.2256,0.1615,0.163,0.1369,0.1041,0.1041]},{"id":"ceps4.0","label":"\u03b5 scale c=4.0","color":"#dc2626","marker":"circle","y":[0.127,0.1499,0.1257,0.1076,0.1014,0.0838,0.0869]}],"hlines":[{"y":0.2857,"color":"#94a3b8","dash":"4,4","label":"oracle"},{"y":0.0,"color":"#cbd5e1","dash":"2,3","label":"never-treat"}],"note":"IPW-O-W value vs \u0393 (uncapped, N=700, 3-seed mean), one curve per Wasserstein-radius scale c_eps. Tight \u03b5 (green/blue) stays robust and good; large \u03b5 (amber/red) is over-conservative and collapses toward never-treat as \u0393 grows."};
